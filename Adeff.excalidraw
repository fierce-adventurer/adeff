      "boundElements": [],
      "updated": 1776187419325,
      "link": null,
      "locked": false,
      "text": "Payload Structure :\n    \n1.  quue.analyze: {\"book_id\": \"uuid\", \"file_key\": \"s3://temp/1.pdf\"}\n\n2. queue.tts.generate:  {\"book_id\": \"uuid\", \"chap_id\": 1, \"start\": 5, \"end\": 12}\n\n3. queue.notifications: {\"channel\": \"TELEGRAM\", \"msg\": \"Book is ready.\"}",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Payload Structure :\n    \n1.  quue.analyze: {\"book_id\": \"uuid\", \"file_key\": \"s3://temp/1.pdf\"}\n\n2. queue.tts.generate:  {\"book_id\": \"uuid\", \"chap_id\": 1, \"start\": 5, \"end\": 12}\n\n3. queue.notifications: {\"channel\": \"TELEGRAM\", \"msg\": \"Book is ready.\"}",
      "autoResize": true,
      "lineHeight": 1.25
    },
