      "isDeleted": false,
      "boundElements": [],
      "updated": 1775770871932,
      "link": null,
      "locked": false,
      "text": "Event Driven Architecture\n- Api Gateway : The outword facing controller\n- Analyzer Worker : Analyzer Table of Contents using Groq.\n- Bhashini TTS Worker : Listens to queue.tts.generate for text to audio\n- Notification Service: Agnostic messanger using interface-driven pluggin",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Event Driven Architecture\n- Api Gateway : The outword facing controller\n- Analyzer Worker : Analyzer Table of Contents using Groq.\n- Bhashini TTS Worker : Listens to queue.tts.generate for text to audio\n- Notification Service: Agnostic messanger using interface-driven pluggin",
      "autoResize": true,
      "lineHeight": 1.25
    },
