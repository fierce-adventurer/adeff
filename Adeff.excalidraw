      "isDeleted": false,
      "boundElements": [],
      "updated": 1775770396262,
      "link": null,
      "locked": false,
      "text": "Characterstics\n- Admin Access : Only Admins can upload audiobooks\n- Architecture : 4 service event driven model\n- Goal : Low latency playback using cloud platforms and api\nfor maximum throughput for highly decoupled sevices.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Characterstics\n- Admin Access : Only Admins can upload audiobooks\n- Architecture : 4 service event driven model\n- Goal : Low latency playback using cloud platforms and api\nfor maximum throughput for highly decoupled sevices.",
